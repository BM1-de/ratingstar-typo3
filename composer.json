{
    "name": "ratingstar/typo3-seal",
    "type": "typo3-cms-extension",
    "version": "1.1.0",
    "description": "RatingStar-Siegel und Google-Sterne (Rich Snippets) einer RatingStar-Filiale für TYPO3.",
    "keywords": [
        "TYPO3 CMS",
        "Extension",
        "ratingstar",
        "reviews",
        "rich snippets",
        "seal",
        "SEO"
    ],
    "homepage": "https://ratingstar.de",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Phillip Baumgärtner",
            "role": "Developer",
            "email": "baumgaertner@bm1.de",
            "homepage": "https://bm1.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "typo3/cms-core": "^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "RatingStar\\Seal\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ratingstar_seal"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    }
}
