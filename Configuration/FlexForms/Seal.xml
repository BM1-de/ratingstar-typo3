<?xml version="1.0" encoding="UTF-8"?>
<!--
    Per-Embed-Optionen des RatingStar-Siegels. Die Felder bilden exakt die
    von seal.js whitelisteten EMBED_OVERRIDES ab (CONTRACT §17) und werden
    als data-*-Attribute ausgegeben. Jedes Feld steht auf „Standard" (leer)
    = keine Ausgabe, dann gilt die zentrale Konfiguration aus dem
    RatingStar-Dashboard („Siegel & Widgets"). Werte-Validierung übernimmt
    seal.js (Ranges/Enums, ungültige Werte fallen still auf den Standard).
-->
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Siegel</sheetTitle>
                <type>array</type>
                <el>
                    <variant>
                        <label>Variante</label>
                        <description>Statische Siegel laufen in jedem Tarif; Live-Widgets (Profil-Karte bis Fußleiste) ab 4-Star — darunter degradiert seal.js automatisch auf die Banderole.</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>seal-circle-banner</default>
                            <items>
                                <numIndex index="0"><label>Banderole</label><value>seal-circle-banner</value></numIndex>
                                <numIndex index="1"><label>Rundsiegel</label><value>seal-circle</value></numIndex>
                                <numIndex index="2"><label>Profil-Karte</label><value>profile-card</value></numIndex>
                                <numIndex index="3"><label>Bewertungsleiste</label><value>bar</value></numIndex>
                                <numIndex index="4"><label>Gesamtnote</label><value>hero</value></numIndex>
                                <numIndex index="5"><label>Zitat</label><value>quote</value></numIndex>
                                <numIndex index="6"><label>Karussell</label><value>carousel</value></numIndex>
                                <numIndex index="7"><label>Bewertungswand</label><value>wall</value></numIndex>
                                <numIndex index="8"><label>Fußleiste</label><value>footer-bar</value></numIndex>
                            </items>
                        </config>
                    </variant>
                    <position>
                        <label>Bildschirmposition (nur Profil-Karte)</label>
                        <description>Die Ecken-Optionen lassen die Karte schwebend am Bildschirmrand kleben (Standard: unten rechts), „inline" rendert sie an dieser Stelle im Inhalt.</description>
                        <displayCond>FIELD:variant:=:profile-card</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>bottom-right</default>
                            <items>
                                <numIndex index="0"><label>unten rechts</label><value>bottom-right</value></numIndex>
                                <numIndex index="1"><label>unten links</label><value>bottom-left</value></numIndex>
                                <numIndex index="2"><label>oben rechts</label><value>top-right</value></numIndex>
                                <numIndex index="3"><label>oben links</label><value>top-left</value></numIndex>
                                <numIndex index="4"><label>inline (an dieser Stelle)</label><value>inline</value></numIndex>
                            </items>
                        </config>
                    </position>
                    <theme>
                        <label>Darstellung</label>
                        <description>„Dunkel" passt Bewertungsleiste, Gesamtnote, Zitat, Karussell und Bewertungswand an dunkle Seitenhintergründe an.</description>
                        <displayCond>FIELD:variant:IN:bar,hero,quote,carousel,wall</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Hell</label><value>light</value></numIndex>
                                <numIndex index="2"><label>Dunkel</label><value>dark</value></numIndex>
                            </items>
                        </config>
                    </theme>
                    <dataAttributes>
                        <label>Weitere data-Attribute (Experten)</label>
                        <description>Zusätzliche per-Embed-Attribute, z. B. aus dem Embed-Code des Dashboard-Generators kopiert (data-size="240" …). Überschreibt gleichnamige Feld-Einstellungen; unbekannte oder ungültige Werte ignoriert seal.js.</description>
                        <config>
                            <type>text</type>
                            <rows>2</rows>
                        </config>
                    </dataAttributes>
                </el>
            </ROOT>
        </sDEF>
        <sStatic>
            <ROOT>
                <sheetTitle>Siegel-Optionen</sheetTitle>
                <displayCond>FIELD:sDEF.variant:IN:seal-circle,seal-circle-banner</displayCond>
                <type>array</type>
                <el>
                    <size>
                        <label>Größe (px)</label>
                        <description>Anzeigebreite des statischen Siegels, 120–320 px. Leer = Standard aus dem Dashboard.</description>
                        <config>
                            <type>input</type>
                            <size>10</size>
                            <placeholder>Standard</placeholder>
                        </config>
                    </size>
                </el>
            </ROOT>
        </sStatic>
        <sPc>
            <ROOT>
                <sheetTitle>Profil-Karte</sheetTitle>
                <displayCond>FIELD:sDEF.variant:=:profile-card</displayCond>
                <type>array</type>
                <el>
                    <pcWidth>
                        <label>Breite (px)</label>
                        <description>100–215 px. Leer = Standard aus dem Dashboard.</description>
                        <config>
                            <type>input</type>
                            <size>10</size>
                            <placeholder>Standard</placeholder>
                        </config>
                    </pcWidth>
                    <pcColor>
                        <label>Kartenfarbe</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Gold (creme)</label><value>gold</value></numIndex>
                                <numIndex index="2"><label>Silber (grau)</label><value>silber</value></numIndex>
                                <numIndex index="3"><label>Weiß</label><value>weiss</value></numIndex>
                            </items>
                        </config>
                    </pcColor>
                    <pcShowCount>
                        <label>Bewertungsanzahl zeigen</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Ja</label><value>1</value></numIndex>
                                <numIndex index="2"><label>Nein</label><value>0</value></numIndex>
                            </items>
                        </config>
                    </pcShowCount>
                    <pcMobile>
                        <label>Mobil-Ansicht (schwebendes Siegel)</label>
                        <description>Unter 640 px Bildschirmbreite: kompakte Pille statt großer Karte, ganz ausblenden oder unverändert lassen. Gilt nur für die schwebende Position.</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Kompakte Pille</label><value>compact</value></numIndex>
                                <numIndex index="2"><label>Ausblenden</label><value>hide</value></numIndex>
                                <numIndex index="3"><label>Karte unverändert</label><value>full</value></numIndex>
                            </items>
                        </config>
                    </pcMobile>
                    <pcClick>
                        <label>Klick auf die Karte</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Bewertungs-Vorschau öffnen</label><value>overlay</value></numIndex>
                                <numIndex index="2"><label>Direkt zum Profil</label><value>profile</value></numIndex>
                            </items>
                        </config>
                    </pcClick>
                </el>
            </ROOT>
        </sPc>
        <sBar>
            <ROOT>
                <sheetTitle>Bewertungsleiste</sheetTitle>
                <displayCond>FIELD:sDEF.variant:=:bar</displayCond>
                <type>array</type>
                <el>
                    <barShowCount>
                        <label>Bewertungsanzahl zeigen</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Ja</label><value>1</value></numIndex>
                                <numIndex index="2"><label>Nein</label><value>0</value></numIndex>
                            </items>
                        </config>
                    </barShowCount>
                    <barShowVerified>
                        <label>Verifiziert-Hinweis zeigen</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Ja</label><value>1</value></numIndex>
                                <numIndex index="2"><label>Nein</label><value>0</value></numIndex>
                            </items>
                        </config>
                    </barShowVerified>
                </el>
            </ROOT>
        </sBar>
        <sHero>
            <ROOT>
                <sheetTitle>Gesamtnote</sheetTitle>
                <displayCond>FIELD:sDEF.variant:=:hero</displayCond>
                <type>array</type>
                <el>
                    <heroShowCount>
                        <label>Bewertungsanzahl zeigen</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Ja</label><value>1</value></numIndex>
                                <numIndex index="2"><label>Nein</label><value>0</value></numIndex>
                            </items>
                        </config>
                    </heroShowCount>
                    <heroShowVerified>
                        <label>Verifiziert-Hinweis zeigen</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Ja</label><value>1</value></numIndex>
                                <numIndex index="2"><label>Nein</label><value>0</value></numIndex>
                            </items>
                        </config>
                    </heroShowVerified>
                </el>
            </ROOT>
        </sHero>
        <sQuote>
            <ROOT>
                <sheetTitle>Zitat</sheetTitle>
                <displayCond>FIELD:sDEF.variant:=:quote</displayCond>
                <type>array</type>
                <el>
                    <quotePick>
                        <label>Zitat-Auswahl</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Beste Bewertung</label><value>best</value></numIndex>
                                <numIndex index="2"><label>Neueste Bewertung</label><value>newest</value></numIndex>
                                <numIndex index="3"><label>Rotierend</label><value>rotate</value></numIndex>
                                <numIndex index="4"><label>Manuell (im Dashboard gewählt)</label><value>manual</value></numIndex>
                            </items>
                        </config>
                    </quotePick>
                    <quoteWidth>
                        <label>Breite</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>S</label><value>s</value></numIndex>
                                <numIndex index="2"><label>M</label><value>m</value></numIndex>
                                <numIndex index="3"><label>L</label><value>l</value></numIndex>
                                <numIndex index="4"><label>Volle Breite</label><value>full</value></numIndex>
                            </items>
                        </config>
                    </quoteWidth>
                </el>
            </ROOT>
        </sQuote>
        <sCarousel>
            <ROOT>
                <sheetTitle>Karussell</sheetTitle>
                <displayCond>FIELD:sDEF.variant:=:carousel</displayCond>
                <type>array</type>
                <el>
                    <carCount>
                        <label>Anzahl Bewertungen</label>
                        <description>3–20. Leer = Standard aus dem Dashboard.</description>
                        <config>
                            <type>input</type>
                            <size>10</size>
                            <placeholder>Standard</placeholder>
                        </config>
                    </carCount>
                    <carRotate>
                        <label>Rotation (Sekunden)</label>
                        <description>0–30, 0 = keine automatische Rotation. Leer = Standard.</description>
                        <config>
                            <type>input</type>
                            <size>10</size>
                            <placeholder>Standard</placeholder>
                        </config>
                    </carRotate>
                    <carMin>
                        <label>Mindest-Sterne</label>
                        <description>1–5. Leer = Standard.</description>
                        <config>
                            <type>input</type>
                            <size>10</size>
                            <placeholder>Standard</placeholder>
                        </config>
                    </carMin>
                    <carWidth>
                        <label>Breite</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>S</label><value>s</value></numIndex>
                                <numIndex index="2"><label>M</label><value>m</value></numIndex>
                                <numIndex index="3"><label>L</label><value>l</value></numIndex>
                                <numIndex index="4"><label>Volle Breite</label><value>full</value></numIndex>
                            </items>
                        </config>
                    </carWidth>
                </el>
            </ROOT>
        </sCarousel>
        <sWall>
            <ROOT>
                <sheetTitle>Bewertungswand</sheetTitle>
                <displayCond>FIELD:sDEF.variant:=:wall</displayCond>
                <type>array</type>
                <el>
                    <wallCols>
                        <label>Spalten</label>
                        <description>2–4. Leer = Standard aus dem Dashboard.</description>
                        <config>
                            <type>input</type>
                            <size>10</size>
                            <placeholder>Standard</placeholder>
                        </config>
                    </wallCols>
                    <wallTotal>
                        <label>Anzahl Bewertungen</label>
                        <description>2–50. Leer = Standard.</description>
                        <config>
                            <type>input</type>
                            <size>10</size>
                            <placeholder>Standard</placeholder>
                        </config>
                    </wallTotal>
                    <wallMin>
                        <label>Mindest-Sterne</label>
                        <description>1–5. Leer = Standard.</description>
                        <config>
                            <type>input</type>
                            <size>10</size>
                            <placeholder>Standard</placeholder>
                        </config>
                    </wallMin>
                    <wallSort>
                        <label>Sortierung</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Neueste zuerst</label><value>newest</value></numIndex>
                                <numIndex index="2"><label>Beste zuerst</label><value>best</value></numIndex>
                                <numIndex index="3"><label>Gemischt</label><value>mix</value></numIndex>
                            </items>
                        </config>
                    </wallSort>
                    <wallWidth>
                        <label>Breite</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>M</label><value>m</value></numIndex>
                                <numIndex index="2"><label>L</label><value>l</value></numIndex>
                                <numIndex index="3"><label>XL</label><value>xl</value></numIndex>
                                <numIndex index="4"><label>Volle Breite</label><value>full</value></numIndex>
                            </items>
                        </config>
                    </wallWidth>
                </el>
            </ROOT>
        </sWall>
        <sFooterBar>
            <ROOT>
                <sheetTitle>Fußleiste</sheetTitle>
                <displayCond>FIELD:sDEF.variant:=:footer-bar</displayCond>
                <type>array</type>
                <el>
                    <footerBarPosition>
                        <label>Position</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Am Bildschirmrand fixiert</label><value>fixed</value></numIndex>
                                <numIndex index="2"><label>Im Seitenfluss (inline)</label><value>inline</value></numIndex>
                            </items>
                        </config>
                    </footerBarPosition>
                    <footerBarBg>
                        <label>Hintergrundfarbe</label>
                        <description>Leer = Standard aus dem Dashboard.</description>
                        <config>
                            <type>color</type>
                            <required>0</required>
                        </config>
                    </footerBarBg>
                    <footerBarText>
                        <label>Schriftfarbe</label>
                        <config>
                            <type>color</type>
                            <required>0</required>
                        </config>
                    </footerBarText>
                    <footerBarLinkColor>
                        <label>Linkfarbe</label>
                        <config>
                            <type>color</type>
                            <required>0</required>
                        </config>
                    </footerBarLinkColor>
                    <footerBarLinkHover>
                        <label>Linkfarbe (Hover)</label>
                        <config>
                            <type>color</type>
                            <required>0</required>
                        </config>
                    </footerBarLinkHover>
                </el>
            </ROOT>
        </sFooterBar>
        <sReviews>
            <ROOT>
                <sheetTitle>Bewertungs-Filter</sheetTitle>
                <displayCond>FIELD:sDEF.variant:IN:profile-card,quote,carousel,wall</displayCond>
                <type>array</type>
                <el>
                    <reviewsOnlyNamed>
                        <label>Nur Bewertungen mit Namen</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Ja</label><value>1</value></numIndex>
                                <numIndex index="2"><label>Nein</label><value>0</value></numIndex>
                            </items>
                        </config>
                    </reviewsOnlyNamed>
                    <reviewsOnlyWithComment>
                        <label>Nur Bewertungen mit Kommentar</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default></default>
                            <items>
                                <numIndex index="0"><label>Standard (aus Dashboard)</label><value></value></numIndex>
                                <numIndex index="1"><label>Ja</label><value>1</value></numIndex>
                                <numIndex index="2"><label>Nein</label><value>0</value></numIndex>
                            </items>
                        </config>
                    </reviewsOnlyWithComment>
                </el>
            </ROOT>
        </sReviews>
    </sheets>
</T3DataStructure>
